  "forbidden_import_regexes": [
    "(?m)^\\s*(?:pub\\s+)?mod\\s+(?:offline_asr|recorder|tui)\\s*;",
    "\\b(?:crate|margins)\\s*::\\s*(?:offline_asr|project|recorder|tui)\\b",
    "(?ms)^\\s*(?:pub\\s+)?use\\s+(?:crate|margins)\\s*::\\s*\\{[^}]*\\b(?:offline_asr|project|recorder|tui)\\b",
    "\\b(?:self|super)\\s*::\\s*(?:offline_asr|project|recorder|tui)\\b",
    "(?m)#\\s*\\[\\s*path\\s*=\\s*[^]]*(?:desktop|src-tauri|project|recorder|tui)",
    "include(?:_bytes|_str)?!\\s*\\([^)]*(?:desktop|src-tauri|project|recorder|tui)",
    "(?m)^\\s*(?:import|export)\\s+.*(?:desktop/|src-tauri/|private[_-]runtime|capture[_-]runtime)",
    "(?m)^\\s*(?:const|let|var)\\s+.*=\\s*require\\([^)]*(?:desktop/|src-tauri/|private[_-]runtime|capture[_-]runtime)",
    "\\b(?:require|import)\\s*\\([^)]*(?:desktop/|src-tauri/|private[_-]runtime|capture[_-]runtime)",
    "(?m)^\\s*(?:from|import)\\s+(?:desktop|private_runtime|capture_runtime)(?:\\.|\\s|$)",
    "(?m)^\\s*from\\s+\\.+(?:private_runtime|capture_runtime)(?:\\.|\\s)",
    "(?m)^\\s*(?:margins-capture-native|margins-desktop|tauri|cpal|cidre|pi_agent_rust)\\s*=",
    "(?m)^\\s*margins\\s*=",
    "(?m)^\\s*windows\\s*=\\s*(?:\\{|[\"'])",
    "(?m)path\\s*=\\s*[\"'][^\"']*(?:desktop|crates/private)[^\"']*[\"']",
    "(?m)path\\s*=\\s*[\"'](?:\\.\\./){2,}[^\"']*[\"']"
  ],
  "secret_content_regexes": [
    "-----BEGIN(?: [A-Z]+)? PRIVATE KEY-----",
    "(?:AKIA|ASIA)[0-9A-Z]{16}",
    "gh[pousr]_[A-Za-z0-9]{36,}",
    "github_pat_[A-Za-z0-9_]{20,}",
    "sk-[A-Za-z0-9]{32,}",
    "(?:sk-ant-api03|sk-proj)-[A-Za-z0-9_-]{20,}",
    "AIza[0-9A-Za-z_-]{35}",
    "xox[baprs]-[0-9A-Za-z-]{10,}",
    "xox[cde]-[0-9A-Za-z-]{10,}",
    "glpat-[A-Za-z0-9_-]{20,}",
    "hf_[A-Za-z0-9]{30,}",
    "npm_[A-Za-z0-9]{36,}",
    "pypi-AgEIcHlwaS5vcmc[A-Za-z0-9_-]{20,}",
    "(?:sk|rk)_live_[0-9A-Za-z]{16,}",
    "(?m)^machine\\s+\\S+\\s+login\\s+\\S+\\s+password\\s+\\S+"
  ]
