class Margins < Formula
  desc "Vault-native meeting capture and transcript workflow CLI"
  homepage "https://github.com/useenzyme/margins"
  license "Apache-2.0"

  if Hardware::CPU.arm?
    url "https://github.com/useenzyme/margins/releases/download/v@VERSION@/margins-@VERSION@-aarch64-apple-darwin.tar.gz"
    sha256 "@ARM_SHA@"
  else
    url "https://github.com/useenzyme/margins/releases/download/v@VERSION@/margins-@VERSION@-x86_64-apple-darwin.tar.gz"
    sha256 "@INTEL_SHA@"
  end

  depends_on :macos

  def install
    bin.install "margins"
  end

  test do
    assert_match "Usage:", shell_output("#{bin}/margins --help")
  end
end
