{
  "name": "margins-desktop",
  "private": true,
  "version": "0.4.8",
  "type": "module",
  "scripts": {
    "test:native-coreml-rolling": "../scripts/cargo-lane disposable -- cargo test --manifest-path src-tauri/Cargo.toml native_coreml_rolling_wav_injector_exercises_finish_reuse_and_drop_rejection -- --ignored --nocapture",
    "dev": "vite",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "icons": "tauri icon ../assets/logo.png --ios-color=#11151b",
    "ux:cdp": "node scripts/ux-cdp.mjs run",
    "ux:cdp:real": "node scripts/ux-real-cdp.mjs",
    "ux:e2e": "playwright test -c test-harness/ux-loop/playwright.config.ts",
    "ux:e2e:headed": "playwright test -c test-harness/ux-loop/playwright.config.ts --headed --workers=1",
    "headless": "node scripts/headless-dev.mjs",
    "headless:check": "node scripts/headless-dev.mjs check",
    "headless:server:check": "../scripts/cargo-lane shared -- scripts/headless-server-check.sh",
    "headless:cdp": "node scripts/headless-dev.mjs cdp",
    "headless:cdp:real": "MARGINS_UX_HEADLESS=1 node scripts/ux-real-cdp.mjs",
    "headless:e2e": "node scripts/headless-dev.mjs e2e",
    "headless:status": "node scripts/headless-dev.mjs status",
    "ux:e2e:real-distill": "node scripts/ux-e2e-real-distill.mjs",
    "ux:e2e:real": "npm run ux:e2e:real-distill && MARGINS_UX_E2E_REUSE_RUNTIME=1 playwright test -c test-harness/ux-loop/playwright.config.ts --grep customer-call-connected-note",
    "ux:e2e:mp4": "node scripts/ux-e2e-mp4.mjs",
    "ux:e2e:judge": "node scripts/ux-e2e-judge.mjs",
    "ux:e2e:report": "node scripts/ux-e2e-report.mjs",
    "ux:e2e:distill-fixture": "../scripts/cargo-lane disposable -- cargo run --manifest-path src-tauri/Cargo.toml --example pi_distill_fixture -- test-harness/ux-loop/fixtures/customer-call",
    "distill:perf": "../scripts/cargo-lane disposable -- node scripts/distill-perf-metrics.mjs",
    "snapshot:state": "../scripts/cargo-lane shared -- scripts/snapshot-local-state.sh",
    "dev:app": "../scripts/cargo-lane shared -- scripts/dev-isolated-auth.sh",
    "dev:app:tools": "MARGINS_OPEN_DEVTOOLS=1 ../scripts/cargo-lane shared -- scripts/dev-isolated-auth.sh",
    "dev:audio-perms": "scripts/dev-audio-permissions.sh --grant",
    "app:reinstall": "../scripts/cargo-lane shared -- scripts/reinstall-app.sh",
    "app:reinstall:devtools": "MARGINS_OPEN_DEVTOOLS=1 MARGINS_TAURI_FEATURES=devtools ../scripts/cargo-lane shared -- scripts/reinstall-app.sh",
    "app:reinstall:first-run": "../scripts/cargo-lane shared -- scripts/reinstall-first-run-test.sh",
    "bundle:mac": "../scripts/cargo-lane shared -- tauri build --bundles app,dmg --config tauri.bundle-mac.conf.json",
    "bundle:mac:signed": "../scripts/cargo-lane shared -- scripts/build-signed-mac.sh",
    "bundle:mac:universal": "../scripts/cargo-lane shared -- tauri build --target universal-apple-darwin --bundles app,dmg --config tauri.bundle-mac.conf.json",
    "tauri:build:updates": "../scripts/cargo-lane shared -- scripts/build-updater-release.sh",
    "tauri:build:windows": "../scripts/cargo-lane shared -- scripts/build-windows-nsis.sh",
    "tauri:dev": "../scripts/cargo-lane shared -- scripts/dev-isolated-auth.sh",
    "tauri:dev:tools": "MARGINS_OPEN_DEVTOOLS=1 ../scripts/cargo-lane shared -- scripts/dev-isolated-auth.sh",
    "tauri:dev:global-auth": "MARGINS_USE_PI_CODING_AGENT_DIR=1 PI_CODING_AGENT_DIR=$HOME/.pi/agent ../scripts/cargo-lane shared -- tauri dev"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@types/markdown-it": "^14.1.2",
    "lucide": "^1.17.0",
    "markdown-it": "^14.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tauri-apps/cli": "^2",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
