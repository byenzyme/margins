#!/usr/bin/env python3
"""Run quick, public, full Linux, or release Mac gates on a managed Cargo lane."""

from __future__ import annotations

import os
from pathlib import Path
import platform
import subprocess
import sys


ROOT = Path(__file__).resolve().parent.parent
LANE = ROOT / "scripts" / "cargo-lane"
BB_PLUGIN = ROOT / "integrations/bb-plugin-margins"
BB_PLUGIN_DIST = "integrations/bb-plugin-margins/dist"
ROOT_PACKAGES = {
    "margins",
    "margins-capture",
    "margins-cli",
    "margins-core",
    "margins-media",
    "margins-meeting-protocol",
    "margins-meeting-runtime",
    "margins-store",
    "margins-workflows",
}
SERVER_MANIFEST = ROOT / "crates/public/margins-server/Cargo.toml"
OFFICIAL_MACOS_FEATURES = "audio-capture,coreml-asr,polyvoice-coreml,recall,recall-local-model"
if SERVER_MANIFEST.exists():
    ROOT_PACKAGES.add("margins-server")
# Direct workspace dependency edges, reversed from the Cargo manifests. Quick
# follows them transitively so a library edit also runs its consumers' tests.
# Keep this map in sync when a root workspace crate adds a local dependency.
REVERSE_DEPENDENTS = {
    "margins-capture": {"margins"},
    "margins-cli": {"margins", "margins-capture"},
    "margins-core": {
        "margins", "margins-capture", "margins-cli", "margins-media", "margins-server",
        "margins-store", "margins-workflows",
    },
    "margins-media": {"margins", "margins-capture", "margins-cli", "margins-server", "margins-workflows"},
    "margins-meeting-protocol": {
        "margins", "margins-capture", "margins-cli", "margins-meeting-runtime",
        "margins-server", "margins-store", "margins-workflows",
    },
    "margins-meeting-runtime": {"margins", "margins-capture", "margins-server", "margins-store", "margins-workflows"},
    "margins-store": {"margins", "margins-capture", "margins-cli", "margins-server", "margins-workflows"},
    "margins-workflows": {"margins", "margins-cli", "margins-server"},
}
# Fast, hermetic script tests (temp dirs and temp git repos only). Each maps to
# the paths whose edits should rerun it under quick; linux and public run them
# all. A new tests/test_*.py is picked up automatically by linux and public.
SCRIPT_TESTS = {
    "tests/test_cargo_lane.py": ("scripts/cargo-lane",),
    "tests/test_design_docs.py": ("desktop/INTEGRATIONS_",),
    "tests/test_portable_scripts.py": (
        "scripts/e2e-",
        "scripts/core-product-smoke.sh",
        "scripts/smoke-official-cli.sh",
        "install.sh",
    ),
    "tests/test_smoke_official_cli.sh": (
        "scripts/smoke-official-cli.sh",
        "scripts/core-product-smoke.sh",
    ),
    "tests/test_setup_e2e_lanes.sh": (
        "scripts/e2e-fresh-workspace-setup.sh",
    ),
}
USAGE = "usage: scripts/local-gate quick <paths-or-crates>... | public | linux | macos | scan [git-range]"


class GateFailure(Exception):
    def __init__(self, label: str, code: int):
        self.label = label
        self.code = code


class Gate:
    def __init__(self, mode: str):
        self.mode = mode
        self.passed: list[str] = []
        self.skipped: list[str] = []

    def run(
        self,
        label: str,
        command: list[str],
        *,
        cwd: Path = ROOT,
        env=None,
        quiet_stdout: bool = False,
    ) -> None:
        print(f"\n==> {label}", flush=True)
        try:
            result = subprocess.run(
                command,
                cwd=cwd,
                env=env,
                check=False,
                stdout=subprocess.DEVNULL if quiet_stdout else None,
            )
        except OSError as exc:
            print(f"local-gate: {exc}", file=sys.stderr)
            raise GateFailure(label, 127) from exc
        if result.returncode:
            raise GateFailure(label, result.returncode)
        self.passed.append(label)

    def cargo(self, label: str, *args: str, cwd: Path = ROOT) -> None:
        # The entrypoint re-executes inside cargo-lane's disposable target.
        self.run(label, ["cargo", *args], cwd=cwd)

    def summary(self, failed: GateFailure | None = None) -> None:
        print(f"\nlocal-gate {self.mode}: {'FAIL' if failed else 'PASS'}")
        for label in self.passed:
            print(f"  PASS {label}")
        for label in self.skipped:
            print(f"  SKIP {label}")
        if failed:
            print(f"  FAIL {failed.label} (exit {failed.code})")


def normalize_input(raw: str) -> str:
    if raw in ROOT_PACKAGES or raw == "margins-desktop":
        return raw
    path = Path(raw)
    if path.is_absolute():
        try:
            path = path.relative_to(ROOT)
        except ValueError as exc:
            raise ValueError(f"path is outside this checkout: {raw}") from exc
    if ".." in path.parts:
        raise ValueError(f"path must stay inside this checkout: {raw}")
    return path.as_posix().removeprefix("./").rstrip("/")


def quick_selection(inputs: list[str]) -> tuple[list[str], bool, bool]:
    packages: set[str] = set()
    parked_desktop = False
    bb_plugin = False
    global_rust = False
    for raw in inputs:
        item = normalize_input(raw)
        if item in ROOT_PACKAGES:
            packages.add(item)
        elif item == "margins-desktop":
            parked_desktop = True
        elif item in {"Cargo.toml", "Cargo.lock"}:
            global_rust = True
        elif is_script_test(item):
            continue
        elif item in {"src", "tests", "examples"} or item.startswith(("src/", "tests/", "examples/")):
            packages.add("margins")
        elif item == "crates/public":
            packages.update(package for package in ROOT_PACKAGES if package.startswith("margins-"))
        elif item.startswith("crates/public/"):
            parts = item.split("/")
            if len(parts) >= 3 and parts[2] in ROOT_PACKAGES:
                packages.add(parts[2])
        elif item == "desktop" or item.startswith("desktop/"):
            parked_desktop = True
        elif item == "integrations/bb-plugin-margins" or item.startswith("integrations/bb-plugin-margins/"):
            bb_plugin = True
    if global_rust:
        packages = ROOT_PACKAGES.copy()
    pending = list(packages)
    while pending:
        for dependent in REVERSE_DEPENDENTS.get(pending.pop(), ()):
            if dependent in ROOT_PACKAGES and dependent not in packages:
                packages.add(dependent)
                pending.append(dependent)
    return sorted(packages), parked_desktop, bb_plugin


def all_script_tests() -> list[str]:
    discovered = {path.relative_to(ROOT).as_posix() for path in (ROOT / "tests").glob("test_*.py")}
    return sorted(discovered | SCRIPT_TESTS.keys())


def is_script_test(item: str) -> bool:
    return item.startswith("tests/test_") and item.endswith((".py", ".sh"))


def quick_script_tests(inputs: list[str]) -> list[str]:
    selected: set[str] = set()
    for raw in inputs:
        item = normalize_input(raw)
        if item in {"scripts", "tests", "scripts/local-gate"}:
            return all_script_tests()
        if is_script_test(item) and item in all_script_tests():
            selected.add(item)
        for test, triggers in SCRIPT_TESTS.items():
            if any(item == trigger or item.startswith(trigger) for trigger in triggers):
                selected.add(test)
    return sorted(selected)


def run_script_tests(gate: Gate, tests: list[str]) -> None:
    for test in tests:
        interpreter = sys.executable if test.endswith(".py") else "bash"
        gate.run(f"script test {test}", [interpreter, test])


def check_bb_plugin(gate: Gate) -> None:
    if not (BB_PLUGIN / "node_modules").is_dir():
        gate.run("install BB plugin dependencies", ["npm", "ci"], cwd=BB_PLUGIN)
    gate.run("typecheck BB plugin", ["npm", "run", "typecheck"], cwd=BB_PLUGIN)
    gate.run("test BB plugin", ["npm", "test"], cwd=BB_PLUGIN)
    gate.run("build BB plugin", ["npm", "run", "build"], cwd=BB_PLUGIN)
    gate.run(
        "verify committed BB plugin dist",
        ["git", "diff", "--exit-code", "HEAD", "--", BB_PLUGIN_DIST],
    )


def check_shipped_linux(gate: Gate, *, cli_already_built: bool = False) -> None:
    if not cli_already_built:
        gate.cargo(
            "check portable CLI",
            "check", "-p", "margins", "--bin", "margins-private",
            "--no-default-features", "--features", "recall", "--locked",
        )
    if SERVER_MANIFEST.exists():
        gate.cargo(
            "check shipped margins-server",
            "check", "-p", "margins-server", "--bin", "margins-server",
            "--no-default-features", "--features", "parakeet-asr", "--locked",
        )


def quick(gate: Gate, inputs: list[str]) -> None:
    run_script_tests(gate, quick_script_tests(inputs))
    packages, parked_desktop, bb_plugin = quick_selection(inputs)
    if packages:
        args = ["test", "--locked", "--no-default-features"]
        for package in packages:
            args.extend(["-p", package])
        if "margins" in packages:
            args.extend(["--features", "recall"])
            use_enzyme_binary(gate)
        gate.cargo("affected root workspace tests", *args)
    if parked_desktop:
        gate.skipped.append("parked desktop path")
    if bb_plugin:
        check_bb_plugin(gate)
    check_shipped_linux(gate)


def use_enzyme_binary(gate: Gate) -> None:
    """Export MARGINS_ENZYME_BIN: the given binary, or the pinned enzyme build."""
    label = "locate or build the pinned enzyme CLI"
    print(f"\n==> {label}", flush=True)
    result = subprocess.run(
        [str(ROOT / "scripts/enzyme-bin")], cwd=ROOT, check=False,
        stdout=subprocess.PIPE, text=True,
    )
    if result.returncode:
        raise GateFailure(label, result.returncode)
    os.environ["MARGINS_ENZYME_BIN"] = result.stdout.strip()
    print(f"MARGINS_ENZYME_BIN={os.environ['MARGINS_ENZYME_BIN']}", flush=True)
    gate.passed.append(label)


def linux(gate: Gate) -> None:
    run_script_tests(gate, all_script_tests())
    check_bb_plugin(gate)
    use_enzyme_binary(gate)
    gate.cargo(
        "portable workspace and recall composition tests",
        "test", "--workspace", "--no-default-features", "--features", "recall", "--locked",
    )
    gate.cargo(
        "build portable recall CLI for onboarding",
        "build", "-p", "margins", "--bin", "margins-private",
        "--no-default-features", "--features", "recall", "--locked",
    )
    binary = Path(os.environ["CARGO_TARGET_DIR"]) / "debug" / "margins-private"
    gate.run(
        "isolated Google onboarding harness",
        ["bash", "tests/test_e2e_fresh_onboarding.sh"],
        env={**os.environ, "MARGINS_E2E_BIN": str(binary)},
    )
    gate.run(
        "Enzyme home isolation through the margins and enzyme binaries",
        ["bash", "scripts/e2e-enzyme-home-isolation.sh"],
        env={**os.environ, "MARGINS_E2E_BIN": str(binary)},
    )
    gate.run(
        "installed margins finds and version-checks its bundled enzyme",
        ["bash", "scripts/e2e-bundled-engine.sh"],
        env={**os.environ, "MARGINS_E2E_BIN": str(binary)},
    )
    gate.run(
        "setup rollout capture contracts",
        ["bash", "tests/test_workspace_setup_rollout_review.sh"],
    )
    check_shipped_linux(gate, cli_already_built=True)


def public(gate: Gate) -> None:
    gate.run(
        "scan public tree for secrets and personal data",
        [
            sys.executable,
            "scripts/scan-public-history.py",
            "--fail-on-secret",
            "--fail-on-personal",
        ],
    )
    run_script_tests(gate, all_script_tests())
    gate.cargo(
        "build and test workspace without recall",
        "test", "--workspace", "--all-targets", "--no-default-features", "--locked",
    )


def macos(gate: Gate) -> None:
    use_enzyme_binary(gate)
    gate.cargo(
        "build official release CLI",
        "build", "--release", "-p", "margins", "--bin", "margins-private", "--locked",
        "--no-default-features", "--features",
        OFFICIAL_MACOS_FEATURES,
    )
    gate.cargo(
        "build public workspace targets",
        "build", "--workspace", "--exclude", "margins", "--all-targets", "--locked",
    )
    gate.cargo(
        "official composition, audio capture, CoreML, and recall integration",
        "test", "-p", "margins", "--locked", "--no-default-features", "--features",
        OFFICIAL_MACOS_FEATURES,
    )
    gate.cargo(
        "assert recall integration tests execute",
        "test", "-p", "margins", "--test", "recall_index_process", "--locked",
        "--no-default-features", "--features", OFFICIAL_MACOS_FEATURES,
    )
    gate.cargo(
        "native capture package targets and probes",
        "test", "-p", "margins-capture", "--all-targets", "--locked",
        "--no-default-features", "--features", "audio-capture,coreml-asr,polyvoice-coreml",
    )
    gate.cargo(
        "public workspace tests",
        "test", "--workspace", "--exclude", "margins", "--all-targets", "--locked",
    )
    if SERVER_MANIFEST.exists():
        gate.cargo(
            "check shipped macOS margins-server",
            "check", "-p", "margins-server", "--bin", "margins-server",
            "--no-default-features", "--features", "coreml-asr", "--locked",
        )


def main() -> int:
    args = sys.argv[1:]
    if not args or args[0] not in {"quick", "public", "linux", "macos", "scan"}:
        print(USAGE, file=sys.stderr)
        return 2
    mode, inputs = args[0], args[1:]
    if (mode == "quick" and not inputs) or (mode not in {"quick", "scan"} and inputs) or (mode == "scan" and len(inputs) > 1):
        print(USAGE, file=sys.stderr)
        return 2
    if mode == "macos" and platform.system() != "Darwin":
        print("local-gate macos requires a Mac host", file=sys.stderr)
        return 2
    if mode == "scan":
        command = [sys.executable, "scripts/scan-public-history.py"]
        if inputs:
            command.extend(["--range", inputs[0]])
        return subprocess.run(command, cwd=ROOT, check=False).returncode
    if os.environ.get("MARGINS_LOCAL_GATE_INSIDE") != "1":
        env = {**os.environ, "MARGINS_LOCAL_GATE_INSIDE": "1"}
        return subprocess.run(
            [str(LANE), "disposable", "--", sys.executable, str(Path(__file__).resolve()), *args],
            cwd=ROOT, env=env, check=False,
        ).returncode
    if os.environ.get("MARGINS_CARGO_LANE_MODE") != "disposable":
        print("local-gate requires a disposable cargo-lane process", file=sys.stderr)
        return 2
    gate = Gate(mode)
    failure = None
    try:
        if mode == "quick":
            quick(gate, inputs)
        elif mode == "public":
            public(gate)
        elif mode == "linux":
            linux(gate)
        else:
            macos(gate)
    except ValueError as exc:
        print(f"local-gate: {exc}", file=sys.stderr)
        return 2
    except GateFailure as exc:
        failure = exc
    gate.summary(failure)
    return failure.code if failure else 0


if __name__ == "__main__":
    raise SystemExit(main())
