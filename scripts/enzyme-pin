#!/usr/bin/env bash
# Read scripts/enzyme-cli.pin and fetch or check the pinned enzyme CLI.
#
#   enzyme-pin get KEY            print one pin value (rev, version, sha256.<target>)
#   enzyme-pin asset TARGET       print the official asset name for a Rust target
#   enzyme-pin fetch TARGET DIR   verify-release, download the official release asset
#                                 of the pinned version, verify its sha256 against the
#                                 pin, and extract DIR/enzyme; on a matching host also
#                                 run check
#   enzyme-pin verify-release TARGET
#                                 require the pinned sha256 to be the asset GitHub
#                                 recorded for release v<version> of byenzyme/enzyme and
#                                 no other published release's asset; when enzyme-rust
#                                 is readable, also require its tag v<version> to be rev
#   enzyme-pin check BINARY       require `BINARY --version` to print the pinned version
#   enzyme-pin host-target        print the Rust target of this host
#
# MARGINS_ENZYME_ASSET=/path/to/enzyme-<platform>.tar.gz makes fetch use a local
# copy of the asset instead of downloading it (tests only). The sha256 check
# still applies; verify-release does not, since the asset is not published.
# MARGINS_ENZYME_PIN=/path/to/pin reads another pin file, and
# MARGINS_ENZYME_RELEASES_API another releases endpoint (tests only).
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
pin_file="${MARGINS_ENZYME_PIN:-$repo_root/scripts/enzyme-cli.pin}"
release_base="https://github.com/byenzyme/enzyme/releases/download"
releases_api="${MARGINS_ENZYME_RELEASES_API:-https://api.github.com/repos/byenzyme/enzyme/releases}"
engine_source="https://github.com/byenzyme/enzyme-rust.git"
work=""
trap 'if [[ -n "$work" ]]; then rm -rf "$work"; fi' EXIT

die() {
  echo "enzyme-pin: $*" >&2
  exit 1
}

get() {
  local key="$1" value
  value="$(sed -n "s/^${key//./\\.} = \"\\([^\"]*\\)\"\$/\\1/p" "$pin_file")"
  [[ -n "$value" ]] || return 1
  printf '%s\n' "$value"
}

asset() {
  case "$1" in
    aarch64-apple-darwin) echo enzyme-macos-arm64.tar.gz ;;
    x86_64-apple-darwin) echo enzyme-macos-x86_64.tar.gz ;;
    x86_64-unknown-linux-gnu) echo enzyme-linux-x86_64.tar.gz ;;
    aarch64-unknown-linux-gnu) echo enzyme-linux-arm64.tar.gz ;;
    *) die "no official enzyme asset for target $1" ;;
  esac
}

host_target() {
  case "$(uname -s)-$(uname -m)" in
    Darwin-arm64) echo aarch64-apple-darwin ;;
    Darwin-x86_64) echo x86_64-apple-darwin ;;
    Linux-x86_64) echo x86_64-unknown-linux-gnu ;;
    Linux-aarch64 | Linux-arm64) echo aarch64-unknown-linux-gnu ;;
    *) die "unsupported host $(uname -s)-$(uname -m)" ;;
  esac
}

sha256_of() {
  if command -v sha256sum >/dev/null; then
    sha256sum "$1" | cut -d ' ' -f1
  else
    shasum -a 256 "$1" | cut -d ' ' -f1
  fi
}

check() {
  local binary="$1" version actual
  version="$(get version)" || die "the pin has no version"
  [[ -x "$binary" ]] || die "$binary is not an executable"
  actual="$(env -i PATH=/usr/bin:/bin "$binary" --version 2>/dev/null)" \
    || die "$binary --version failed"
  [[ "$actual" == "enzyme $version" ]] \
    || die "$binary reports '$actual'; Margins pins 'enzyme $version'"
}

# The public release tags point at plugin-sync commits, not enzyme-rust revs,
# and enzyme-rust is private, so CI cannot read the tag behind an asset. What
# it can prove publicly: the pinned digest is GitHub's own digest for this
# version's asset, and no other release ever published those bytes, so an old
# release cannot be pinned under a new version.
verify_release() {
  local target="$1" version name expected tagged
  version="$(get version)" || die "the pin has no version"
  name="$(asset "$target")"
  expected="$(get "sha256.$target")" || die "the pin has no sha256.$target"
  python3 - "$releases_api" "v$version" "$name" "$expected" <<'PY' || exit 1
import json, os, sys, urllib.request
api, tag, name, expected = sys.argv[1:5]
headers = {"Accept": "application/vnd.github+json", "User-Agent": "margins-enzyme-pin"}
token = os.environ.get("GH_TOKEN") or os.environ.get("GITHUB_TOKEN")
if token:
    headers["Authorization"] = f"Bearer {token}"
releases, page = [], 1
while True:
    request = urllib.request.Request(f"{api}?per_page=100&page={page}", headers=headers)
    with urllib.request.urlopen(request, timeout=30) as response:
        batch = json.load(response)
    releases += batch
    if len(batch) < 100:
        break
    page += 1
digest = f"sha256:{expected}"
pinned = [r for r in releases if r["tag_name"] == tag]
if not pinned:
    sys.exit(f"enzyme-pin: byenzyme/enzyme has no release {tag}")
recorded = [a.get("digest") for a in pinned[0]["assets"] if a["name"] == name]
if recorded != [digest]:
    sys.exit(f"enzyme-pin: release {tag} records {name} as {recorded or 'missing'}; the pin is {digest}")
others = sorted({r["tag_name"] for r in releases if r["tag_name"] != tag
                 for a in r["assets"] if a.get("digest") == digest})
if others:
    sys.exit(f"enzyme-pin: the pinned {name} is also the asset of {', '.join(others)}; "
             f"{tag} must be a new release built from rev")
PY
  if tagged="$(GIT_TERMINAL_PROMPT=0 git ls-remote "$engine_source" "refs/tags/v$version" "refs/tags/v$version^{}" 2>/dev/null)"; then
    tagged="$(awk '{ commit = $1 } END { print commit }' <<<"$tagged")"
    [[ -z "$tagged" || "$tagged" == "$(get rev)" ]] \
      || die "enzyme-rust tag v$version is $tagged; the pin's rev is $(get rev)"
  fi
}

fetch() {
  local target="$1" dir="$2" version name expected source actual entries
  version="$(get version)" || die "the pin has no version"
  name="$(asset "$target")"
  expected="$(get "sha256.$target")" \
    || die "enzyme $version is not pinned for $target: publish the enzyme release v$version and record sha256.$target in scripts/enzyme-cli.pin"
  [[ "$expected" =~ ^[0-9a-f]{64}$ ]] || die "sha256.$target is not a sha256 digest"

  work="$(mktemp -d "${TMPDIR:-/tmp}/enzyme-pin.XXXXXX")"
  if [[ -n "${MARGINS_ENZYME_ASSET:-}" ]]; then
    source="$MARGINS_ENZYME_ASSET"
  else
    verify_release "$target"
    source="$work/$name"
    curl --proto '=https' --tlsv1.2 -fsSL --retry 3 \
      -o "$source" "$release_base/v$version/$name" \
      || die "could not download $release_base/v$version/$name"
  fi
  actual="$(sha256_of "$source")"
  [[ "$actual" == "$expected" ]] \
    || die "$name has sha256 $actual; the pin for $target is $expected"

  # The official asset is one regular file named enzyme.
  entries="$(tar -tzvf "$source")"
  [[ "$(wc -l <<<"$entries" | tr -d ' ')" == 1 && "$entries" == -* \
    && "$(tar -tzf "$source" | sed 's#^\./##')" == enzyme ]] \
    || die "$name does not contain exactly one regular file named enzyme"
  mkdir "$work/unpacked"
  tar -xzf "$source" -C "$work/unpacked"
  chmod 0755 "$work/unpacked/enzyme"
  if [[ "$target" == "$(host_target)" ]]; then
    check "$work/unpacked/enzyme"
  fi
  mkdir -p "$dir"
  install -m 0755 "$work/unpacked/enzyme" "$dir/enzyme"
  echo "enzyme $version ($target) verified at $dir/enzyme" >&2
}

case "${1:-}" in
  get) [[ $# == 2 ]] || die "usage: enzyme-pin get KEY"; get "$2" || die "the pin has no $2" ;;
  asset) [[ $# == 2 ]] || die "usage: enzyme-pin asset TARGET"; asset "$2" ;;
  fetch) [[ $# == 3 ]] || die "usage: enzyme-pin fetch TARGET DIR"; fetch "$2" "$3" ;;
  check) [[ $# == 2 ]] || die "usage: enzyme-pin check BINARY"; check "$2" ;;
  verify-release) [[ $# == 2 ]] || die "usage: enzyme-pin verify-release TARGET"; verify_release "$2" ;;
  host-target) host_target ;;
  *) die "usage: enzyme-pin get|asset|fetch|check|verify-release|host-target ..." ;;
esac
