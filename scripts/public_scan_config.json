{
  "schema_version": 1,
  "history_filter_paths": [
    "crates/private/recall-engine/",
    "crates/private/margins-google/resources/google-oauth-client.json",
    "open-source-boundary.json",
    "scripts/open_source_boundary.py",
    "tests/test_open_source_boundary.py",
    "scripts/e2e-public-export-workspace-setup.sh",
    ".github/workflows/open-source-boundary.yml",
    ".github/workflows/release.yml",
    "public-repository/"
  ],
  "rules": {
    "private-key": "-----BEGIN(?: [A-Z]+)? PRIVATE KEY-----",
    "aws-access-key": "(?:AKIA|ASIA)[0-9A-Z]{16}",
    "github-token": "(?:gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{20,})",
    "openai-key": "(?:sk-[A-Za-z0-9]{32,}|(?:sk-ant-api03|sk-proj)-[A-Za-z0-9_-]{20,})",
    "google-api-key": "AIza[0-9A-Za-z_-]{35}",
    "slack-token": "(?:xox[baprs]-[0-9A-Za-z-]{10,}|xox[cde]-[0-9A-Za-z-]{10,})",
    "gitlab-token": "glpat-[A-Za-z0-9_-]{20,}",
    "huggingface-token": "hf_[A-Za-z0-9]{30,}",
    "npm-token": "npm_[A-Za-z0-9]{36,}",
    "pypi-token": "pypi-AgEIcHlwaS5vcmc[A-Za-z0-9_-]{20,}",
    "stripe-live-key": "(?:sk|rk)_live_[0-9A-Za-z]{16,}",
    "netrc-password": "(?m)^machine\\s+\\S+\\s+login\\s+\\S+\\s+password\\s+\\S+",
    "oauth-client-secret": "\"client_secret\"\\s*:\\s*\"(?!REPLACE_ME|EXAMPLE|example|fixture|test|dummy)[^\"]{8,}\"",
    "personal-macos-path": "/Users[/]joshua[^\\s\"'<>)]*",
    "personal-linux-path": "/home[/]dev(?:/[^\\s\"'<>)]*)?",
    "email-address": "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9][A-Za-z0-9.-]*\\.[A-Za-z]{2,}\\b"
  },
  "synthetic_email_domains": [
    "example.com",
    "example.org",
    "example.net",
    "example.test",
    "test.invalid",
    "users.noreply.github.com"
  ],
  "synthetic_secret_paths": [
    "tests/test_workspace_setup_rollout_review.sh"
  ]
}
