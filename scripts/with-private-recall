#!/usr/bin/env bash
# Run an official composition command with the pinned private git dependency.
set -euo pipefail

if [[ $# -eq 0 ]]; then
  echo "usage: scripts/with-private-recall <command> [args...]" >&2
  exit 2
fi

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Record checkout dirtiness before the manifest substitution below, so the
# embedded build info (`margins --version`) does not report the wrapper's own
# temporary Cargo.toml/Cargo.lock edits as uncommitted changes.
if [[ -z "${MARGINS_BUILD_DIRTY+x}" ]] \
  && status="$(git -C "$repo_root" status --porcelain 2>/dev/null)"; then
  if [[ -n "$status" ]]; then
    export MARGINS_BUILD_DIRTY=true
  else
    export MARGINS_BUILD_DIRTY=false
  fi
fi
backup_dir="$(mktemp -d)"
cp "$repo_root/Cargo.toml" "$backup_dir/Cargo.toml"
cp "$repo_root/Cargo.lock" "$backup_dir/Cargo.lock"
restore() {
  cp "$backup_dir/Cargo.toml" "$repo_root/Cargo.toml"
  cp "$backup_dir/Cargo.lock" "$repo_root/Cargo.lock"
  rm -rf "$backup_dir"
}
trap restore EXIT

python3 "$repo_root/scripts/private_recall_manifest.py" --apply
if [[ -f "$repo_root/Cargo.private-recall.lock" ]]; then
  cp "$repo_root/Cargo.private-recall.lock" "$repo_root/Cargo.lock"
fi
export MARGINS_PRIVATE_RECALL_ACTIVE=1
# The checkout's own (public) Cargo.toml and Cargo.lock, for tools such as
# scripts/local-gate that must inspect them while the substitution is active.
export MARGINS_PRIVATE_RECALL_PUBLIC_DIR="$backup_dir"
if [[ -z "${CARGO_NET_GIT_FETCH_WITH_CLI+x}" ]]; then
  export CARGO_NET_GIT_FETCH_WITH_CLI=true
fi
"$@"
